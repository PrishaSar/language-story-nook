# AI provider label (used in logs / key checks). Match the active block in src/lib/ai/provider.ts
# Options: gemini | ollama | openai | anthropic
AI_PROVIDER=gemini

# --- Google Gemini / AI Studio (default / active) ---
# Paste your key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=paste-your-google-ai-studio-key-here
AI_MODEL=gemini-3.6-flash

# --- Ollama (when you uncomment the Ollama block in provider.ts) ---
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2

# --- OpenAI (when you uncomment the OpenAI block in provider.ts) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o-mini

# --- Anthropic (when you uncomment the Anthropic block in provider.ts; needs @ai-sdk/anthropic) ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-sonnet-4-5

# Session signing (change in production)
SESSION_SECRET=dev-secret-change-me

# Read-aloud and word hover do not need keys.
# Read-aloud uses the browser's built-in speech.
# Hover lookup uses MyMemory (free). PennApps used
# https://ftapi.pythonanywhere.com/translate, which is offline.
