# AI provider label (used in logs / key checks). Match the active block in src/lib/ai/provider.ts
# Options: ollama | openai | anthropic
AI_PROVIDER=ollama

# --- Ollama (default / active) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3.2

# --- OpenAI (when you uncomment the OpenAI block in provider.ts) ---
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-4o-mini

# --- Anthropic (when you uncomment the Anthropic block in provider.ts; needs @ai-sdk/anthropic) ---
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AI_MODEL=claude-sonnet-4-5

# Session signing (change in production)
SESSION_SECRET=dev-secret-change-me
